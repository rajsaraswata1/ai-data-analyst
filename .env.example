APP_ENV=development
SECRET_KEY=
MAX_UPLOAD_SIZE_MB=50
MAX_ROWS=2000000
CACHE_ENABLED=true
CACHE_TTL_SECONDS=900
LOG_LEVEL=INFO
# DATA_DIR=./data         # SQLite DB, uploaded CSVs, generated dev secret
# LOG_DIR=./logs
# SAMPLES_DIR=            # optional: directory holding sales.csv/customers.csv/products.csv for the 'Load sample datasets' button
CURRENCY_SYMBOL=₹
REGISTRATION_OPEN=true
# --- Optional LLM (leave LLM_PROVIDER=none for the deterministic local engine) ---
LLM_PROVIDER=none            # none | openai  (any OpenAI-compatible /chat/completions endpoint)
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=
LLM_TIMEOUT_SECONDS=30
